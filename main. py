import discord
import os
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print("البوت اشتغل")

@bot.command()
async def سلام(ctx):
    await ctx.send("اهلا بيك!")

bot.run(os.getenv("TOKEN"))
